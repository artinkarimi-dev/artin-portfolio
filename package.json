{
  "name": "artin-karimi-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "qa": "node scripts/qa.mjs",
    "check": "npm run sourcecheck && npm run lint && npm run typecheck && npm run build && npm run qa",
    "sourcecheck": "node scripts/source-check.mjs",
    "release": "node scripts/release-check.mjs && npm run check"
  },
  "dependencies": {
    "lenis": "1.3.26",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0"
  }
}
